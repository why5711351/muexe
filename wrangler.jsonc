{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "muexe",
  "compatibility_date": "2025-01-01",
  "pages_build_output_dir": "./dist",
  "ai": {
    "binding": "AI"
  },
  // API keys (CHOCO_API_KEY / SUPADATA_API_KEY) are encrypted Secrets in the
  // Cloudflare dashboard: Settings -> Variables and Secrets. Do NOT declare
  // them in "vars" here — this repo is public, and a Secret cannot share a
  // name with an existing Variable (Cloudflare rejects the duplicate name).
  "vars": {}
}
